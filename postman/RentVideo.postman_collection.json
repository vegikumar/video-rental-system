{
  "info": {
    "name": "RentVideo",
    "description": "Postman collection for the RentVideo Video Rental System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "customerPassword", "value": "password123" },
    { "key": "userId", "value": "1" },
    { "key": "videoId", "value": "1" },
    { "key": "rentalId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "List Available Videos",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerEmail}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/videos"
          }
        },
        {
          "name": "Create Video (ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"director\": \"Christopher Nolan\",\n  \"genre\": \"Sci-Fi\"\n}"
            },
            "url": "{{baseUrl}}/api/videos"
          }
        },
        {
          "name": "Update Video (ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"director\": \"Christopher Nolan\",\n  \"genre\": \"Thriller\",\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/videos/{{videoId}}"
          }
        },
        {
          "name": "Delete Video (ADMIN)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/videos/{{videoId}}"
          }
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Rent Video",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerEmail}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/rentals/users/{{userId}}/videos/{{videoId}}"
          }
        },
        {
          "name": "Return Video",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerEmail}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "PUT",
            "url": "{{baseUrl}}/api/rentals/{{rentalId}}/return"
          }
        },
        {
          "name": "Active Rentals",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerEmail}}" },
                { "key": "password", "value": "{{customerPassword}}" }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/rentals/users/{{userId}}/active"
          }
        }
      ]
    }
  ]
}
